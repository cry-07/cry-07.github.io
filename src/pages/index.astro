---
import BlogLayout from '../layouts/BlogLayout.astro';
import { site, href, notesHref } from '../../site.config.mjs';
import { chapters } from '../../chapters.mjs';
import { getPosts } from '../lib/posts';
const posts = getPosts();
const entries = [...posts.map(p => ({...p, category:'articles', categoryLabel:'文章', link:href(`posts/${p.slug}/`), no:'', group:'文章'})), ...chapters.map(c => ({...c, category:'notes', categoryLabel:'计算方法', description:c.summary, date:'', tags:[c.group], link:notesHref(`notes/${c.slug}`)}))];
const groups = [...new Set(chapters.map(c => c.group))];
---
<BlogLayout>
  <main id="main" class="home-grid">
    <aside class="profile-column" aria-label="个人简介">
      <div class="avatar" aria-hidden="true">{site.initials}<span>✳</span></div>
      <h2 class="profile-name">{site.author}</h2><p class="profile-bio">{site.bio}</p>
      <a class="text-link" href={href('about/')}>关于这里 <span>↗</span></a>
      {(site.github || site.email) && <div class="social-links">{site.github && <a href={site.github} rel="me">GitHub ↗</a>}{site.email && <a href={`mailto:${site.email}`}>Email ↗</a>}</div>}
      <div class="side-section"><span class="eyebrow">EXPLORE / 内容</span><nav class="category-nav" aria-label="内容分类"><button data-filter="all" aria-pressed="true"><span>全部记录</span><small>{entries.length.toString().padStart(2,'0')}</small></button><button data-filter="notes" aria-pressed="false"><span>课程笔记</span><small>09</small></button><button data-filter="articles" aria-pressed="false"><span>文章随笔</span><small>{posts.length.toString().padStart(2,'0')}</small></button></nav></div>
      <div class="profile-note"><span>✳</span><p>知识不是收藏，<br />是一次次重新理解。</p></div>
    </aside>
    <section class="feed-column" aria-label="学习记录">
      <div class="section-header"><div><span class="eyebrow">THE NOTEBOOK</span><h2>学习的痕迹<span>.</span></h2></div><span class="count-label">持续积累中</span></div>
      <a class="featured-course" href={notesHref()} aria-label="打开计算方法讲义，9 篇笔记与牛顿法交互演示">
        <div class="feature-topline"><span class="pill">专题讲义</span><span>NUMERICAL METHODS <span class="feature-arrow">↗</span></span></div>
        <div class="feature-body"><div><h3>计算方法</h3><p>从一个近似值，<br />走向更清晰的答案。</p><span class="feature-meta">9 篇笔记 <i>·</i> 公式推导 <i>·</i> 交互演示</span></div><svg class="feature-graph" viewBox="0 0 220 160" aria-hidden="true"><g stroke="currentColor" opacity=".12"><path d="M0 40H220M0 80H220M0 120H220M40 0V160M80 0V160M120 0V160M160 0V160M200 0V160"/></g><path d="M8 132C42 132 46 20 84 42S122 130 155 83 187 24 216 30" fill="none" stroke="currentColor" stroke-width="2.3"/><path d="M52 143 183 16" stroke="currentColor" opacity=".4" stroke-dasharray="4 4"/><circle cx="127" cy="70" r="4" fill="currentColor"/><path d="M127 70V145" stroke="currentColor" opacity=".3" stroke-dasharray="3 4"/><text x="140" y="147" fill="currentColor" font-family="serif" font-size="12" opacity=".6">xₖ₊₁</text></svg></div>
        <span class="feature-cta">进入讲义，开始阅读 <span>→</span></span>
      </a>
      <div class="feed-toolbar"><span id="feed-title">全部记录 <small id="result-count">{entries.length}</small></span><label class="search-field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><input id="entry-search" type="search" placeholder="搜索标题与摘要" aria-label="搜索标题、摘要与分类" /></label></div>
      <div id="entry-list">{entries.map(entry => <article class="entry" data-category={entry.category} data-group={entry.group} data-search={`${entry.title} ${entry.description} ${entry.tags.join(' ')}`.toLowerCase()}><div class="entry-topline"><span>{entry.categoryLabel}{entry.no && ` / ${entry.no}`}</span><span>{entry.date || entry.group}</span></div><a href={entry.link}><h3>{entry.title}<span>↗</span></h3><p>{entry.description}</p></a><div class="entry-bottom">{entry.tags.map(tag => <span>{tag}</span>)}<span class="entry-read">阅读全文 →</span></div></article>)}</div>
      <div id="empty-state" class="empty-state" hidden><span>∅</span><h3>这里还没有记录</h3><p>可以换一个关键词，或去课程讲义里继续探索。</p><button id="clear-filters">查看全部记录 →</button></div>
      <div class="feed-end"><span></span><p>每一次理解，都值得留下。</p><span></span></div>
    </section>
    <aside class="context-column" aria-label="内容索引"><div class="side-heading"><span class="eyebrow">ON THE DESK</span><span>01</span></div><h3>正在整理</h3><a class="desk-card" href={notesHref()}><div class="mini-book"><span>计算方法</span><small>NUMERICAL<br/>METHODS</small><b>∑</b></div><strong>计算方法讲义</strong><span>把公式连成思路 <span>↗</span></span></a><div class="side-section"><span class="eyebrow">TOPICS / 主题</span><div class="topic-list">{groups.map(group => <button data-topic={group} aria-pressed="false">{group} <span>↗</span></button>)}</div></div><div class="reading-route"><span class="eyebrow">A WAY THROUGH</span><h4>从哪里开始？</h4><p>先理解误差从何而来，再看算法如何一步步靠近答案。</p><a href={notesHref('notes/error-analysis')}>从误差分析读起 →</a></div><div class="side-signature">Stay curious.<span>慢慢来，比较快。</span></div></aside>
  </main>
  <script>
    const entries = [...document.querySelectorAll<HTMLElement>('.entry')];
    let category = 'all', topic = '';
    const search = document.querySelector<HTMLInputElement>('#entry-search')!;
    function render() {
      const query = search.value.trim().toLowerCase(); let count = 0;
      for (const entry of entries) { const visible = (category === 'all' || entry.dataset.category === category) && (!topic || entry.dataset.group === topic) && (entry.dataset.search || '').includes(query); entry.hidden = !visible; if(visible) count++; }
      document.querySelector('#result-count')!.textContent = String(count);
      document.querySelector<HTMLElement>('#empty-state')!.hidden = count !== 0;
      document.querySelectorAll('[data-filter]').forEach(btn => btn.setAttribute('aria-pressed', String(btn.getAttribute('data-filter') === category)));
      document.querySelectorAll('[data-topic]').forEach(btn => btn.setAttribute('aria-pressed', String(btn.getAttribute('data-topic') === topic)));
    }
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(btn => btn.addEventListener('click', () => { category = btn.dataset.filter!; topic = ''; render(); }));
    document.querySelectorAll<HTMLButtonElement>('[data-topic]').forEach(btn => btn.addEventListener('click', () => { topic = topic === btn.dataset.topic ? '' : btn.dataset.topic!; category = topic ? 'notes' : 'all'; render(); }));
    search.addEventListener('input', render);
    document.querySelector('#clear-filters')?.addEventListener('click', () => { category = 'all'; topic = ''; search.value = ''; render(); });
  </script>
</BlogLayout>
