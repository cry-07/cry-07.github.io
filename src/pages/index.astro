---
import BlogLayout from '../layouts/BlogLayout.astro';
import { site, href } from '../../site.config.mjs';
import { courses } from '../../courses.mjs';
import { getPosts } from '../lib/posts';
const posts = getPosts();
const noteEntries = courses.flatMap(course => course.chapters.map(c => ({...c, category:'notes', categoryLabel:course.title, description:c.summary, date:'', tags:[course.title,c.group].filter((t,i,a) => a.indexOf(t)===i), link:course.link('notes/'+c.slug)})));
const entries = [...posts.map(p => ({...p, category:'articles', categoryLabel:'文章', link:href('posts/'+p.slug+'/'), no:'', group:'文章'})), ...noteEntries];
---
<BlogLayout>
  <main id="main" class="home-grid">
    <aside class="profile-column" aria-label="个人简介">
      <div class="avatar" aria-hidden="true">{site.initials}<span>✳</span></div>
      <h2 class="profile-name">{site.author}</h2><p class="profile-bio">{site.bio}</p>
      <a class="text-link" href={href('about/')}>关于这里 <span>↗</span></a>
      {(site.github || site.email) && <div class="social-links">{site.github && <a href={site.github} rel="me">GitHub ↗</a>}{site.email && <a href={`mailto:${site.email}`}>Email ↗</a>}</div>}
      <div class="side-section"><span class="eyebrow">EXPLORE / 内容</span><nav class="category-nav" aria-label="内容分类"><button data-filter="all" aria-pressed="true"><span>全部记录</span><small>{entries.length.toString().padStart(2,'0')}</small></button><button data-filter="notes" aria-pressed="false"><span>课程笔记</span><small>{noteEntries.length.toString().padStart(2,'0')}</small></button><button data-filter="articles" aria-pressed="false"><span>文章随笔</span><small>{posts.length.toString().padStart(2,'0')}</small></button></nav></div>
      <div class="profile-note"><span>✳</span><p>知识不是收藏，<br />是一次次重新理解。</p></div>
    </aside>
    <section class="feed-column" aria-label="学习记录">
      <div class="section-header"><div><span class="eyebrow">THE NOTEBOOK</span><h2>学习的痕迹<span>.</span></h2></div><span class="count-label">持续积累中</span></div>
      <div class="feed-toolbar"><span id="feed-title">全部记录 <small id="result-count">{entries.length}</small></span><label class="search-field"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><input id="entry-search" type="search" placeholder="搜索标题与摘要" aria-label="搜索标题、摘要与分类" /></label></div>
      <div id="entry-list">{entries.map(entry => <article class="entry" data-category={entry.category} data-group={entry.group} data-search={`${entry.categoryLabel} ${entry.title} ${entry.description} ${entry.tags.join(' ')}`.toLowerCase()}><div class="entry-topline"><span>{entry.categoryLabel}{entry.no && ` / ${entry.no}`}</span><span>{entry.date || entry.group}</span></div><a href={entry.link}><h3>{entry.title}<span>↗</span></h3><p>{entry.description}</p></a><div class="entry-bottom">{entry.tags.map(tag => <span>{tag}</span>)}<span class="entry-read">阅读全文 →</span></div></article>)}</div>
      <div id="empty-state" class="empty-state" hidden><span>∅</span><h3>这里还没有记录</h3><p>可以换一个关键词，或去课程讲义里继续探索。</p><button id="clear-filters">查看全部记录 →</button></div>
      <div class="feed-end"><span></span><p>每一次理解，都值得留下。</p><span></span></div>
    </section>
    <aside class="context-column" aria-label="专题讲义">
      <div class="side-heading"><span class="eyebrow">COURSES / 专题讲义</span><span>{courses.length.toString().padStart(2,'0')}</span></div>
      <div class="course-list">{courses.map(course => <a class="course-card" data-course={course.id} href={course.link()}>
        <div class="course-card-top"><span class="eyebrow">{course.english}</span><span aria-hidden="true">↗</span></div>
        <span class="course-symbol" aria-hidden="true">{course.symbol}</span>
        <h3>{course.title}</h3><p>{course.description}</p>
        <span class="course-detail">{course.chapters.length} 篇笔记 · {course.detail}</span>
        <span class="course-cta">进入专题 <span>→</span></span>
      </a>)}</div>
    </aside>
  </main>
  <script>
    const entries = [...document.querySelectorAll<HTMLElement>('.entry')];
    let category = 'all';
    const search = document.querySelector<HTMLInputElement>('#entry-search')!;
    function render() {
      const query = search.value.trim().toLowerCase(); let count = 0;
      for (const entry of entries) { const visible = (category === 'all' || entry.dataset.category === category) && (entry.dataset.search || '').includes(query); entry.hidden = !visible; if(visible) count++; }
      document.querySelector('#result-count')!.textContent = String(count);
      document.querySelector<HTMLElement>('#empty-state')!.hidden = count !== 0;
      document.querySelectorAll('[data-filter]').forEach(btn => btn.setAttribute('aria-pressed', String(btn.getAttribute('data-filter') === category)));
    }
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(btn => btn.addEventListener('click', () => { category = btn.dataset.filter!; render(); }));
    search.addEventListener('input', render);
    document.querySelector('#clear-filters')?.addEventListener('click', () => { category = 'all'; search.value = ''; render(); });
  </script>
</BlogLayout>
